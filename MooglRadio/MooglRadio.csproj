<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>MooglRadio</AssemblyName>
    <Version>0.1.0.0</Version>
    <Description>Listen to MOOGLradio, the FFXIV-themed internet radio station, in-game.</Description>
    <Company>MOOGLradio</Company>
    <Product>MooglRadio</Product>
    <Authors>MOOGLradio</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MooglRadio.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    DRAFT: packaging via DalamudPackager (pulled in by the Dalamud.NET.Sdk)
    is intentionally left commented out until this has been built against
    a real local Dalamud install and the current DalamudPackager task
    parameters have been confirmed — this environment has no Dalamud
    install to verify against. See README.md "Building" for the checklist.

  <Target Name="PackagePlugin" AfterTargets="Build">
    <DalamudPackager
      ProjectDir="$(ProjectDir)"
      OutputPath="$(OutputPath)"
      AssemblyName="$(AssemblyName)"
      VersionComponents="4"
      MakeZip="true" />
  </Target>
  -->

</Project>
