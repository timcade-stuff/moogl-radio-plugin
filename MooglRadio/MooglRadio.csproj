<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>MooglRadio</AssemblyName>
    <Version>0.1.7.0</Version>
    <Description>Listen to MOOGLradio, the FFXIV-themed internet radio station, in-game.</Description>
    <Company>MOOGLradio</Company>
    <Product>MooglRadio</Product>
    <Authors>MOOGLradio</Authors>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MooglRadio.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Packaging via DalamudPackager (pulled in by the Dalamud.NET.Sdk).
    Produces a MooglRadio.zip somewhere under bin/Release on build — the
    CI workflow (.github/workflows/release.yml) globs for it and uploads
    it to GitHub Releases, which is what repo.json's DownloadLink* fields
    point at.
    Params unverified against a real Dalamud install (see README.md); if
    the build fails here on a real machine, check DalamudPackager's
    current parameter names against its NuGet package README.
  -->
  <Target Name="PackagePlugin" AfterTargets="Build">
    <DalamudPackager
      ProjectDir="$(ProjectDir)"
      OutputPath="$(OutputPath)"
      AssemblyName="$(AssemblyName)"
      VersionComponents="4"
      MakeZip="true" />
  </Target>

</Project>
